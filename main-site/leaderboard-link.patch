+  .ln-head { display: flex; align-items: center; gap: 10px; }
+  .ln-live { white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; font: var(--fw-label) var(--fs-label) / 1 var(--font-mono); letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--accent); }
