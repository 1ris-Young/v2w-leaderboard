+        if (drag.onPill) {
+          const swallow = (c: Event) => { c.stopImmediatePropagation(); c.preventDefault(); };
+          pill.addEventListener('click', swallow, { capture: true, once: true });
+          setTimeout(() => pill.removeEventListener('click', swallow, { capture: true }), 250);
+        }
