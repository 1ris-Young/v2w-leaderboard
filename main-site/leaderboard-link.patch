+
+/* "NEW" pill after the Leaderboard pill: latest leaderboard news (Navbar.astro). */
+.nav-new {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  align-self: center;
+  padding: 6px 14px 6px 6px;
+  border-radius: 999px;
+  background: var(--warm-solid);
+  color: var(--bg);
+  white-space: nowrap;
+}
+nav a.nav-new:hover {
+  background: var(--warm-solid-hover);
+  color: var(--bg);
+}
+.nav-new-tag {
+  padding: 2px 8px;
+  border-radius: 999px;
+  background: var(--warm-tint);
+  color: var(--warm-ink);
+  font: var(--fw-label) var(--fs-label) / var(--lh-label) var(--font-mono);
+  letter-spacing: var(--ls-label);
+  text-transform: uppercase;
+}
