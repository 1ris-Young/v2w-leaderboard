+    const keep = () => { if (root.classList.contains('is-placed')) { const r = root.getBoundingClientRect(); place(r.left, r.top); } };
+    window.addEventListener('resize', keep);
+    pill.addEventListener('click', () => requestAnimationFrame(keep));
+    root.querySelector('[data-ln-min]')?.addEventListener('click', () => requestAnimationFrame(keep));
+  }
+</script>
+
