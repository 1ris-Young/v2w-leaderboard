+---
+// "Live leaderboard" notice (2026-10-18): after the hero, a card slides in at the top right with
+// the latest model results from the leaderboard's News feed, the models still in evaluation and a
+// link into Model News. After a few seconds it folds into a small "Live" pill that stays in the
+// corner. Data: public/leaderboard/data/{news,leaderboard}.json, copied in from the leaderboard
+// repository; without them nothing renders.
+import site from '../data/site.json';
+import { asset } from '../lib/paths';
+
+type Entry = { id: string; title: string; headline?: string; href?: string; detail?: string; status: string; kind?: string; date: string; model_id?: string; cover?: string };
+type Model = { id: string; name: string; metrics: Record<string, number> };
+type Board = { models: Model[]; pending_models?: { id: string; name: string }[] };
+const newsFeeds = import.meta.glob<{ entries: Entry[] }>('../../public/leaderboard/data/news.json', { eager: true, import: 'default' });
+const boardFeeds = import.meta.glob<Board>('../../public/leaderboard/data/leaderboard.json', { eager: true, import: 'default' });
+const news = Object.values(newsFeeds)[0];
+const boardData = Object.values(boardFeeds)[0];
+const board = site.resources.find((r) => r.id === 'leaderboard');
+const base = (board?.url ?? 'leaderboard/').replace(/\/$/, '');
+
+const published = (news?.entries ?? [])
+  .filter((e) => e.status === 'published' && e.kind === 'model_result')
+  .sort((a, b) => b.date.localeCompare(a.date) || (a.detail === 'report' ? -1 : b.detail === 'report' ? 1 : 0));
+const latestDate = published[0]?.date;
+const fresh = published.filter((e) => e.date === latestDate);
+const items = published.slice(0, 3).map((e) => {
+  const model = boardData?.models.find((m) => m.id === e.model_id);
+  return {
+    name: model?.name ?? e.title,
+    headline: e.headline ?? e.title,
+    score: model ? model.metrics.score.toFixed(2) : null,
+    href: asset(`${base}/`), // every item opens the leaderboard, whose Model News leads the page
+    cover: e.cover ? asset(`${base}/${e.cover}`) : null,
+  };
+});
+const pending = boardData?.pending_models ?? [];
+const day = (d?: string) => (d ? new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '');
+---
+
+{items.length > 0 && (
+  <aside class="live-news" data-live-news aria-label="Leaderboard updates">
+    <div class="ln-card" id="live-news-card" title="Drag to move">
+      <span class="ln-grip" aria-hidden="true"></span>
+      <div class="ln-head">
+        <span class="ln-live"><i aria-hidden="true"></i>Live leaderboard</span>
+        <span class="ln-date" title={`Updated ${day(latestDate)}`}>{day(latestDate)}</span>
+        <button class="ln-min" type="button" aria-label="Minimise updates" title="Minimise" data-ln-min>–</button>
+        <button class="ln-close" type="button" aria-label="Close updates" title="Close" data-ln-close>×</button>
+      </div>
+      <p class="ln-title">{fresh.length} new model {fresh.length === 1 ? 'result' : 'results'}</p>
+      <ol class="ln-list">
+        {items.map((it, i) => (
+          <li style={`--i:${i}`}>
+            <a class="ln-item" href={it.href}>
+              <span class="ln-thumb">{it.cover && <img src={it.cover} alt="" loading="lazy" decoding="async" />}</span>
+              <span class="ln-text">
+                <span class="ln-name">{it.name}{it.score && <em>{it.score}</em>}</span>
+                <span class="ln-headline">{it.headline}</span>
+              </span>
+            </a>
+          </li>
+        ))}
+      </ol>
+      {pending.length > 0 && (
+        <p class="ln-next"><span class="ln-next-label">In evaluation</span><span class="ln-next-names">{pending.map((m) => m.name).join(', ')}</span><span class="ln-bar" aria-hidden="true"><i></i></span></p>
+      )}
+      <a class="ln-cta" href={asset(`${base}/`)}>Open Model News <span aria-hidden="true">→</span></a>
+    </div>
+    <button class="ln-pill" type="button" aria-controls="live-news-card" aria-expanded="false" data-ln-pill>
+      <i aria-hidden="true"></i><span>Live · {fresh.length} new {fresh.length === 1 ? 'result' : 'results'}</span>
+    </button>
+    <button class="ln-pill-close" type="button" aria-label="Close updates" title="Close" data-ln-close>×</button>
+  </aside>
+)}
+
+<script>
+  // Appears when the paper title (#abstract .paper-title) comes into view, always as the full
+  // card; folds to the pill once the reader has scrolled on (see arm) or on "–"; the pill opens
+  // it again; "×" closes it for the visit (see close).
+  const root = document.querySelector<HTMLElement>('[data-live-news]');
+  // the paper title block ("Video2World" with the authors) at the start of the Abstract
+  const title = document.querySelector<HTMLElement>('#abstract .paper-title') || document.getElementById('abstract');
+  if (root) {
+    const KEY = 'v2w-live-news-min';
+    const store = { get: () => { try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; } }, set: (v: boolean) => { try { sessionStorage.setItem(KEY, v ? '1' : '0'); } catch { /* storage unavailable */ } } };
+    const pill = root.querySelector<HTMLButtonElement>('[data-ln-pill]')!;
+    let timer = 0, shown = false;
+    const setPillW = () => root.style.setProperty('--pill-w', `${pill.offsetWidth}px`);
+    const fold = (remember = false) => { root.classList.add('is-min'); pill.setAttribute('aria-expanded', 'false'); setPillW(); if (remember) store.set(true); };
+    const open = () => { root.classList.remove('is-min'); pill.setAttribute('aria-expanded', 'true'); arm(); };
+    // fold rule: not a timer but reading progress. The card stays open until the reader has
+    // scrolled about 1.2 screens on from where it opened (and not while the pointer is on it).
+    let startY = window.scrollY;
+    const arm = () => { clearTimeout(timer); startY = window.scrollY; };
+    window.addEventListener('scroll', () => {
+      if (!shown || root.classList.contains('is-min') || root.classList.contains('is-closing')) return;
+      if (Math.abs(window.scrollY - startY) > window.innerHeight * 1.2 && !root.matches(':hover, :focus-within')) fold();
+    }, { passive: true });
+    const show = () => {
+      if (shown) return; shown = true;
+      root.classList.add('is-in');
+      pill.setAttribute('aria-expanded', 'true'); arm(); // always opens as the full card
+    };
+    root.querySelector('[data-ln-min]')?.addEventListener('click', () => fold(true));
+
+    // Close for the visit: the notice folds into a dot that flies to the navigation's Live Leaderboard pill
+    // (or the Menu button when the navigation is folded), which then pulses with a short note
+    // saying where new results live.
+    const OFF = 'v2w-live-news-off';
+    const off = () => { try { return sessionStorage.getItem(OFF) === '1'; } catch { return false; } };
+    if (off()) root.remove();
+    const header = document.querySelector<HTMLElement>('.site-header');
+    const navTarget = () => {
+      const menu = document.querySelector<HTMLElement>('.menu-toggle');
+      const news = document.querySelector<HTMLElement>('.nav-board');
+      return menu && getComputedStyle(menu).display !== 'none' ? menu : news;
+    };
+    const hint = (target: HTMLElement) => {
+      header?.classList.add('ln-pin');
+      target.classList.add('ln-landed');
+      const tip = document.createElement('div');
+      tip.className = 'ln-tip';
+      tip.setAttribute('role', 'status');
+      tip.innerHTML = '<span class="ln-tip-dot" aria-hidden="true"></span><span><b>New results land in the Live Leaderboard</b><small>Model News updates as new models are evaluated</small></span>';
+      document.body.append(tip);
+      const placeTip = () => { const r = target.getBoundingClientRect(); tip.style.top = `${r.bottom + 14}px`; tip.style.left = `${Math.min(window.innerWidth - tip.offsetWidth - 12, Math.max(12, r.left + r.width / 2 - tip.offsetWidth / 2))}px`; tip.style.setProperty('--ax', `${r.left + r.width / 2 - parseFloat(tip.style.left)}px`); };
+      requestAnimationFrame(() => { placeTip(); tip.classList.add('is-on'); });
+      const done = () => { tip.classList.remove('is-on'); target.classList.remove('ln-landed'); header?.classList.remove('ln-pin'); setTimeout(() => tip.remove(), 400); };
+      setTimeout(done, 4800);
+    };
+    const close = () => {
+      try { sessionStorage.setItem(OFF, '1'); } catch { /* storage unavailable */ }
+      clearTimeout(timer);
+      const from = (root.classList.contains('is-min') ? pill : root.querySelector('.ln-card'))!.getBoundingClientRect();
+      root.classList.add('is-closing');
+      header?.classList.add('ln-pin'); // bring the navigation back so the target is visible
+      const target = navTarget();
+      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      setTimeout(() => {
+        root.remove();
+        if (!target) return;
+        if (reduce) { hint(target); return; }
+        // the dot re-aims at the target every frame, since the navigation may still be sliding in
+        const dot = document.createElement('span');
+        dot.className = 'ln-fly';
+        document.body.append(dot);
+        const sx = from.left + from.width / 2, sy = from.top + from.height / 2, t0 = performance.now(), DUR = 760;
+        const ease = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
+        const step = (now: number) => {
+          const k = Math.min(1, (now - t0) / DUR), e = ease(k), to = target.getBoundingClientRect();
+          const ex = to.left + to.width / 2, ey = to.top + to.height / 2;
+          const cx = (sx + ex) / 2 + (ex < sx ? -60 : 60), cy = Math.min(sy, ey) - 80; // raised control point: an arc
