+          if (k < 1) requestAnimationFrame(step); else { dot.remove(); hint(target); }
+        };
+        requestAnimationFrame(step);
+      }, reduce ? 0 : 280);
+    };
+    root.querySelectorAll('[data-ln-close]').forEach((b) => b.addEventListener('click', close));
+    pill.addEventListener('click', () => { store.set(false); open(); });
+    root.addEventListener('pointerenter', () => clearTimeout(timer));
+
+    if (title && 'IntersectionObserver' in window) {
+      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { show(); io.disconnect(); } }, { rootMargin: '0px 0px -25% 0px' });
+      io.observe(title);
+    } else show();
+
+    // Drag: the card (outside its links and buttons) or the pill can be moved anywhere on screen;
+    // a short press on the pill still opens it. The position is kept for the visit.
+    const POS = 'v2w-live-news-pos';
+    const place = (x: number, y: number) => {
+      const box = (root.classList.contains('is-min') ? pill : root.querySelector('.ln-card'))!.getBoundingClientRect();
+      const w = Math.max(box.width, 120), h = Math.max(box.height, 40);
+      const nx = Math.min(Math.max(8, x), window.innerWidth - w - 8), ny = Math.min(Math.max(8, y), window.innerHeight - h - 8);
+      root.style.left = `${nx}px`; root.style.top = `${ny}px`; root.style.right = 'auto'; root.style.bottom = 'auto'; root.classList.add('is-placed');
+      return [nx, ny];
+    };
+    try { const p = JSON.parse(sessionStorage.getItem(POS) || 'null'); if (p) place(p[0], p[1]); } catch { /* no stored position */ }
+    let drag: { x: number; y: number; ox: number; oy: number; moved: boolean; onPill: boolean } | null = null;
+    root.addEventListener('pointerdown', (e) => {
+      const t = e.target as HTMLElement;
+      if (e.button !== 0 || t.closest('[data-ln-close]') || (t.closest('a, [data-ln-min]') && !t.closest('[data-ln-pill]'))) return;
+      const r = root.getBoundingClientRect();
+      const anchor = (root.classList.contains('is-min') ? pill : root.querySelector('.ln-card'))!.getBoundingClientRect();
+      drag = { x: e.clientX, y: e.clientY, ox: anchor.left, oy: anchor.top, moved: false, onPill: !!t.closest('[data-ln-pill]') };
